// @bun
// relay.ts
var {serve } = globalThis.Bun;
var PORT = Number(process.env.RELAY_PORT || 18720);
var UPSTREAM = process.env.ZO_API_BASE || "https://api.zo.computer";
var ZO_API_KEY = process.env.ZO_API_KEY || "";
function withCors(status, body, extra = {}) {
  return new Response(body, {
    status,
    headers: {
      "Content-Type": "application/json",
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
      "Access-Control-Allow-Headers": "content-type, authorization, x-zo-token",
      ...extra
    }
  });
}
serve({
  port: PORT,
  async fetch(req) {
    const url = new URL(req.url);
    if (req.method === "OPTIONS") {
      return new Response(null, {
        status: 204,
        headers: {
          "Access-Control-Allow-Origin": "*",
          "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
          "Access-Control-Allow-Headers": "content-type, authorization, x-zo-token"
        }
      });
    }
    if (url.pathname === "/health") {
      return withCors(200, JSON.stringify({ ok: true }));
    }
    if (url.pathname === "/zo/ask" && req.method === "POST") {
      const incomingToken = req.headers.get("X-Zo-Token");
      const key = incomingToken || ZO_API_KEY;
      if (!key) {
        return withCors(500, JSON.stringify({ error: "No Zo API token. Set ZO_API_KEY or send X-Zo-Token from the extension." }));
      }
      let payload;
      try {
        payload = await req.json();
      } catch {
        return withCors(400, JSON.stringify({ error: "Invalid JSON body" }));
      }
      if (typeof payload.input !== "string" || !payload.input.trim()) {
        return withCors(400, JSON.stringify({ error: 'Missing "input"' }));
      }
      payload.stream = true;
      payload.include_context_link = false;
      payload.output_format = undefined;
      const upstream = await fetch(`${UPSTREAM}/zo/ask`, {
        method: "POST",
        headers: {
          Authorization: `Bearer ${key}`,
          "Content-Type": "application/json",
          Accept: "text/event-stream"
        },
        body: JSON.stringify(payload)
      });
      const headers = new Headers(upstream.headers);
      headers.set("Access-Control-Allow-Origin", "*");
      headers.set("Access-Control-Allow-Headers", "content-type, authorization, x-zo-token");
      headers.delete("content-encoding");
      return new Response(upstream.body, { status: upstream.status, headers });
    }
    return withCors(404, JSON.stringify({ error: "Not found" }));
  }
});
console.log(`Zo Sidebar relay listening on http://127.0.0.1:${PORT} (proxy -> ${UPSTREAM}/zo/ask)`);
