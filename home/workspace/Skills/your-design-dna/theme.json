{
  "name": "bound-book-cardstack",
  "type": "theme",
  "colors": {
    "parchment": "#F5E6C8",
    "ink": "#1A1A1A",
    "fiberBrown": "#8B7355",
    "fiberInk": "#2C2C2C",
    "stitch": "#D4C5A0",
    "active": "#2E7D32",
    "waiting": "#F57C00",
    "done": "#1565C0"
  },
  "typography": {
    "heading": {
      "fontFamily": "\"IM Fell English\", \"UnifrakturMaguntia\", Georgia, serif",
      "fontWeight": 700,
      "letterSpacing": "0.02em",
      "lineHeight": 1.3
    },
    "body": {
      "fontFamily": "Georgia, serif",
      "fontWeight": 400,
      "letterSpacing": "0.02em",
      "lineHeight": 1.5
    }
  },
  "spacing": {
    "pagePadding": "24px",
    "cardGap": "16px",
    "maxWidth": "1200px"
  },
  "elevation": {
    "rest": "0 2px 4px rgba(0,0,0,0.08)",
    "hover": "0 8px 24px rgba(0,0,0,0.15)"
  },
  "motion": {
    "foldDuration": "120ms",
    "foldEasing": "cubic-bezier(0.4, 0, 0.2, 1)",
    "parallaxTrigger": "on-scroll",
    "parallaxIntensity": "moderate"
  },
  "components": {
    "card": {
      "borderRadius": "0",
      "foldCorner": "top-right",
      "foldSize": "24px"
    },
    "ribbon": {
      "width": "6px",
      "position": "top"
    }
  }
}
