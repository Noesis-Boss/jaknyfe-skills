---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CodeChip from '../components/CodeChip.astro';
import CopyButton from '../components/CopyButton.astro';
import heroImg from '../assets/ai-starter-skill-pack-hero.png';
import {
  REPO,
  INSTALL_CMD,
  skillFile,
  skills,
  questions,
  runtimes,
  features,
  defaults,
  stats,
} from '../data/site';
---

<Base>
  {/* ----------------------------------------------------------------- Hero */}
  <section class="hero">
    <div class="container container--wide hero__inner">
      <span class="eyebrow" data-reveal>Open-source Agent Skills · MIT</span>
      <h1 data-reveal style="--reveal-delay: 60ms">
        Learn to use AI properly — <em>one small step at a time.</em>
      </h1>
      <p class="hero__lede" data-reveal style="--reveal-delay: 120ms">
        The AI Starter Skill Pack is five small Agent Skills that help you start,
        get unstuck, learn by doing, build something real, and make honest
        progress. No hype. No fifty-tool shopping list. No promise that prompt
        tricks land you a job.
      </p>
      <div class="hero__actions" data-reveal style="--reveal-delay: 180ms">
        <a class="btn btn--primary" href="#skills">
          Explore the five skills
          <Icon name="arrow" size={18} />
        </a>
        <a class="btn btn--secondary" href={REPO} target="_blank" rel="noopener">
          <Icon name="github" size={18} />
          View on GitHub
        </a>
      </div>
      <div class="hero__install" data-reveal style="--reveal-delay: 240ms">
        <CodeChip command={INSTALL_CMD} />
      </div>
      <p class="hero__note" data-reveal style="--reveal-delay: 300ms">
        <Icon name="spark" size={16} />
        Works with Claude Code, Codex, and other Agent Skills runtimes.
      </p>
    </div>

    <div class="container container--wide hero__media" data-reveal style="--reveal-delay: 360ms">
      <Image
        class="hero__img"
        src={heroImg}
        alt="The five AI Starter Skill Pack skills laid out as a calm, step-by-step path: a doorway for getting started, a magnifier over a chat for debugging prompts, books and a graduation cap for learning, a lightbulb for project ideas, and a mountain with a flag for proving your skills."
        widths={[480, 800, 1200, 1672]}
        sizes="(min-width: 1180px) 1080px, 92vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </section>

  {/* ------------------------------------------------------------ Questions */}
  <section class="section section--alt" id="questions">
    <div class="container container--wide">
      <div class="section__head" data-reveal>
        <span class="eyebrow">Five ordinary questions</span>
        <h2 class="section__title">
          Most beginners don't need another list of tools.
        </h2>
        <p class="section__lede">
          They need help answering five ordinary questions — and a sensible next
          action for each. Each skill owns one question.
        </p>
      </div>

      <ol class="questions">
        {
          questions.map((q, i) => (
            <li class="question" data-reveal style={`--reveal-delay: ${i * 60}ms`}>
              <span class="question__num" aria-hidden="true" />
              <span class="question__text">{q.text}</span>
              <a class="question__skill" href={`#${q.skillId}`}>
                {q.skillId}
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* --------------------------------------------------------------- Skills */}
  <section class="section" id="skills">
    <div class="container container--wide">
      <div class="section__head" data-reveal>
        <span class="eyebrow">The five skills</span>
        <h2 class="section__title">A starter operating system, not a course.</h2>
        <p class="section__lede">
          Use them in order, or reach for whichever one fits. They deliberately
          overlap at the handoffs — onboarding picks a first step, the tutor
          teaches, the project skill scopes a build, the career skill weighs the
          evidence, and the debugger repairs one model interaction.
        </p>
      </div>

      <div class="journey">
        {
          skills.map((skill, i) => (
            <article class="skill" id={skill.id} data-reveal>
              <div class="skill__rail">
                <span class="skill__num" aria-hidden="true">
                  {i + 1}
                </span>
              </div>
              <div class="skill__card">
                <div class="skill__top">
                  <h3 class="skill__name">{skill.name}</h3>
                  <span class="skill__tagline">{skill.tagline}</span>
                </div>
                <code class="tag">{skill.id}</code>
                <div class="skill__body">
                  <div class="skill__row">
                    <span class="skill__label">Use it when</span>
                    <span class="skill__value">{skill.use}</span>
                  </div>
                  <div class="skill__row">
                    <span class="skill__label">You get</span>
                    <span class="skill__value">
                      <strong>{skill.get}</strong>
                    </span>
                  </div>
                </div>
                <p class="skill__example">{skill.example}</p>
                <a
                  class="skill__link"
                  href={skillFile(skill.id)}
                  target="_blank"
                  rel="noopener"
                >
                  Read the skill
                  <Icon name="arrow" size={16} />
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------------- Stats */}
  <section class="stats-band" aria-label="What's in the pack">
    <div class="container container--wide">
      <p class="stats-band__intro" data-reveal>
        Small, but not slight — every skill ships with reference methods,
        reusable templates, and trigger-eval tests.
      </p>
      <div class="stats">
        {
          stats.map((s, i) => (
            <div class="stat" data-reveal style={`--reveal-delay: ${i * 60}ms`}>
              <span class="stat__value">{s.value}</span>
              <span class="stat__label">{s.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------- What is a skill */}
  <section class="section section--alt" id="how">
    <div class="container container--wide">
      <div class="section__head" data-reveal>
        <span class="eyebrow">More than a prompt</span>
        <h2 class="section__title">Why these behave like skills, not tricks.</h2>
        <p class="section__lede">
          Each skill is a small operating procedure. That's why the same skill
          behaves well across very different questions — and knows when to step
          aside.
        </p>
      </div>

      <div class="features">
        {
          features.map((f, i) => (
            <div class="feature" data-reveal style={`--reveal-delay: ${(i % 4) * 60}ms`}>
              <span class="feature__icon">
                <Icon name={f.icon} />
              </span>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------- Defaults */}
  <section class="section" id="defaults">
    <div class="container container--wide">
      <div class="section__head" data-reveal>
        <span class="eyebrow">Beginner-safe by default</span>
        <h2 class="section__title">Built to keep beginners safe.</h2>
        <p class="section__lede">
          Unless you say otherwise, every skill follows the same calm defaults —
          so the first step is small, private, and actually doable.
        </p>
      </div>

      <div class="defaults">
        {
          defaults.map((d, i) => (
            <div class="default" data-reveal style={`--reveal-delay: ${(i % 3) * 60}ms`}>
              <span class="default__check" aria-hidden="true">
                <Icon name="check" size={18} />
              </span>
              <p>
                <strong>{d.lead}</strong> {d.rest}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* -------------------------------------------------------------- Install */}
  <section class="section section--alt" id="install">
    <div class="container container--wide">
      <div class="section__head" data-reveal>
        <span class="eyebrow">Install</span>
        <h2 class="section__title">Add it to your runtime.</h2>
        <p class="section__lede">
          A skill is one folder with a <code>SKILL.md</code> at its root. Copy the
          ones you want, or install the whole pack from GitHub.
        </p>
      </div>

      <div class="install__primary" data-reveal>
        <h3>Install the whole pack</h3>
        <p>
          Exposes every skill under <code>node_modules/ai-starter-skill-pack/skills/</code>.
        </p>
        <CodeChip command={INSTALL_CMD} />
        <p>
          Or copy any folder from <code>skills/</code> straight into your
          runtime's skills directory — each skill works on its own.
        </p>
      </div>

      <div class="runtimes">
        {
          runtimes.map((r, i) => (
            <div class="runtime" data-reveal style={`--reveal-delay: ${(i % 3) * 60}ms`}>
              <h4>
                <Icon name="terminal" size={18} />
                {r.name}
              </h4>
              <p>{r.note}</p>
              {r.path && <code>{r.path}</code>}
            </div>
          ))
        }
      </div>

      <div class="install__caveat" data-reveal>
        <Icon name="info" size={20} />
        <p>
          <strong>Discovery paths are runtime-specific and change.</strong> Check
          the current docs for your tool before deploying — the links are in the
          footer.
        </p>
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------------- Demos */}
  <section class="section" id="try">
    <div class="container container--wide">
      <div class="section__head" data-reveal>
        <span class="eyebrow">Just ask</span>
        <h2 class="section__title">You don't memorize commands. You ask.</h2>
        <p class="section__lede">
          Native runtimes pick the right skill from your question. Here's the
          kind of thing people actually say.
        </p>
      </div>

      <div class="demos">
        {
          skills.map((skill, i) => (
            <figure class="demo" data-reveal style={`--reveal-delay: ${(i % 3) * 60}ms`}>
              <blockquote class="demo__quote">{skill.example}</blockquote>
              <figcaption class="demo__foot">
                <span>handled by</span>
                <a class="tag" href={`#${skill.id}`}>
                  {skill.id}
                </a>
              </figcaption>
            </figure>
          ))
        }
        <div class="demo" data-reveal style="--reveal-delay: 180ms">
          <p class="demo__quote" style="font-style: normal">
            Fewer people wandering through tool lists. More people completing one
            safe workflow, one real learning loop, one inspectable project, and
            one honest next step.
          </p>
          <div class="demo__foot">
            <a class="btn btn--primary" href={REPO} target="_blank" rel="noopener" style="margin-top:.25rem">
              <Icon name="github" size={18} />
              Get the pack
            </a>
            <CopyButton text={INSTALL_CMD} label="npm install" />
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
