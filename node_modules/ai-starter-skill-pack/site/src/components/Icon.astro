  layout:
    '<rect x="3" y="4" width="18" height="16" rx="2.5"/><path d="M3 9.5h18M9 9.5V20"/>',
  book:
    '<path d="M12 6.6C10.4 5.6 7.9 5 5 5v12c2.9 0 5.4.6 7 1.6 1.6-1 4.1-1.6 7-1.6V5c-2.9 0-5.4.6-7 1.6z"/><path d="M12 6.6v12"/>',
  check: '<path d="M5 12.5l4.5 4.5L19 7"/>',
  spark:
    '<path d="M12 2.5c.6 4.7 1.8 5.9 6.5 6.5-4.7.6-5.9 1.8-6.5 6.5-.6-4.7-1.8-5.9-6.5-6.5 4.7-.6 5.9-1.8 6.5-6.5z" fill="currentColor" stroke="none"/><path d="M19 14.5c.3 2.2.9 2.8 3 3-2.1.3-2.7.9-3 3-.3-2.1-.9-2.7-3-3 2.1-.2 2.7-.8 3-3z" fill="currentColor" stroke="none"/>',
