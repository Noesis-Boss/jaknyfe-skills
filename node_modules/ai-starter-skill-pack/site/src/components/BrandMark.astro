---
interface Props {
  class?: string;
  size?: number;
}
const { class: className = 'mark', size = 32 } = Astro.props;
---
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <rect width="32" height="32" rx="8.5" fill="#1d6a51" />
  <path
    d="M9 22.5l7-5 7-5"
    stroke="#faf7f1"
    stroke-width="2.1"
    stroke-linecap="round"
    stroke-linejoin="round"
    opacity="0.85"
  />
  <circle cx="9" cy="22.5" r="2.4" fill="#faf7f1" />
  <circle cx="16" cy="17.5" r="2.4" fill="#faf7f1" />
  <circle cx="23" cy="12.5" r="2.4" fill="#faf7f1" />
</svg>
