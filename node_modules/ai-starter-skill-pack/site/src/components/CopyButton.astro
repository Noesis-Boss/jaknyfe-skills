---
import Icon from './Icon.astro';

interface Props {
  text: string;
  label?: string;
}
const { text, label = 'Copy' } = Astro.props;
---
<button
  class="copy"
  type="button"
  data-clipboard={text}
  aria-label={`Copy "${text}" to clipboard`}
>
  <Icon name="copy" />
  <span class="copy__label">{label}</span>
</button>
