---
import '../styles/global.css';
import BrandMark from '../components/BrandMark.astro';
import Icon from '../components/Icon.astro';
import { REPO, SITE_URL, REVIEWED } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'AI Starter Skill Pack — learn to use AI properly, one step at a time',
  description = 'Five small, open-source Agent Skills that help beginners start with AI, fix prompts, learn by doing, build something real, and make honest career progress. No hype, no fifty-tool shopping list.',
} = Astro.props;

// BASE_URL may or may not carry a trailing slash depending on config; normalize.
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const home = `${base}/`;
const faviconHref = `${base}/favicon.svg`;
const ogImage = `${SITE_URL}ai-starter-skill-pack-social.png`;
const year = 2026;
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={SITE_URL} />

    <link rel="icon" href={faviconHref} type="image/svg+xml" />
    <meta
      name="theme-color"
      content="#faf7f1"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#14120d"
      media="(prefers-color-scheme: dark)"
    />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={SITE_URL} />
    <meta property="og:title" content="AI Starter Skill Pack" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1731" />
    <meta property="og:image:height" content="909" />
    <meta property="og:image:alt" content="AI Starter Skill Pack — five small Agent Skills, shown as labelled folders packed into a box" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="AI Starter Skill Pack" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Inter:wght@400;500;600;700&display=swap"
    />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <header class="site-header" id="top">
      <div class="container container--wide nav">
        <a class="brand" href={home} aria-label="AI Starter Skill Pack — home">
          <BrandMark />
          <span>AI Starter Skill Pack</span>
        </a>
        <nav class="nav__links" aria-label="Primary">
          <a href="#skills" class="nav__hide-sm">Skills</a>
          <a href="#defaults" class="nav__hide-sm">Safety</a>
          <a href="#install" class="nav__hide-sm">Install</a>
          <a
            class="btn btn--secondary nav__cta"
            href={REPO}
            target="_blank"
            rel="noopener"
          >
            <Icon name="github" size={18} />
            GitHub
          </a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container container--wide">
        <div class="footer__grid">
          <div class="footer__brand">
            <a class="brand" href={home} aria-label="AI Starter Skill Pack — home">
              <BrandMark />
              <span>AI Starter Skill Pack</span>
            </a>
            <p>
              Five small Agent Skills for getting unstuck, learning by doing,
              building useful proof, and making honest career progress with AI.
            </p>
            <p class="footer__meta">
              Open-source · MIT · Research snapshot reviewed {REVIEWED}.
            </p>
          </div>

          <div class="footer__col">
            <h5>Project</h5>
            <ul>
              <li><a href={REPO} target="_blank" rel="noopener">Repository</a></li>
              <li>
                <a href={`${REPO}#readme`} target="_blank" rel="noopener">README</a>
              </li>
              <li>
                <a href={`${REPO}/issues`} target="_blank" rel="noopener">
                  Issues &amp; feedback
                </a>
              </li>
              <li>
                <a href={`${REPO}/blob/HEAD/LICENSE`} target="_blank" rel="noopener">
                  MIT License
                </a>
              </li>
            </ul>
          </div>

          <div class="footer__col">
            <h5>Learn more</h5>
            <ul>
              <li>
                <a href="https://agentskills.io/specification" target="_blank" rel="noopener">
                  Agent Skills spec
                </a>
              </li>
              <li>
                <a
                  href="https://agentskills.io/skill-creation/best-practices"
                  target="_blank"
                  rel="noopener"
                >
                  Skill best practices
                </a>
              </li>
              <li>
                <a href="https://code.claude.com/docs/en/skills" target="_blank" rel="noopener">
                  Claude Code skills
                </a>
              </li>
              <li>
                <a href="https://developers.openai.com/codex/skills" target="_blank" rel="noopener">
                  Codex skills
                </a>
              </li>
            </ul>
          </div>
        </div>

        <div class="footer__privacy">
          <p>
            <strong>A note on privacy:</strong> don't paste secrets or sensitive
            records into an AI tool just because a skill asks for context. Use
            placeholders or the minimum necessary excerpt.
          </p>
          <p>© {year} · Built by Jeff Kazzee.</p>
        </div>
      </div>
    </footer>

    <script>
      // Copy-to-clipboard buttons
      const copyButtons =
        document.querySelectorAll<HTMLButtonElement>('.copy');
      copyButtons.forEach((btn) => {
        btn.addEventListener('click', async () => {
          const text = btn.dataset.clipboard ?? '';
          const label = btn.querySelector<HTMLElement>('.copy__label');
          try {
            await navigator.clipboard.writeText(text);
          } catch {
            return;
          }
          const original = label?.textContent ?? 'Copy';
          btn.classList.add('is-copied');
          if (label) label.textContent = 'Copied';
          window.setTimeout(() => {
            btn.classList.remove('is-copied');
            if (label) label.textContent = original;
          }, 1600);
        });
      });

      // Sticky header shadow
      const header = document.querySelector('.site-header');
      const onScroll = () => {
        if (!header) return;
        header.classList.toggle('is-stuck', window.scrollY > 6);
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // Reveal on scroll (respect reduced motion)
      const reveals = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reduced = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;
      if (reduced || !('IntersectionObserver' in window)) {
        reveals.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.08 }
        );
        reveals.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
