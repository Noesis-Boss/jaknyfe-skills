#!/usr/bin/env python3
"""Trello progress-comment dedupe guard.

Usage:
  trello-progress check "Project Name" [max_age_hours]   # exit 0 = post, 1 = skip (recent)
  trello-progress mark "Project Name"                     # record timestamp now

State: /home/workspace/memory/trello-progress-state.json
"""
import json
import sys
from datetime import datetime, timezone, timedelta

STATE = "/home/workspace/memory/trello-progress-state.json"


def main() -> int:
    args = sys.argv[1:]
    if len(args) < 2 or args[0] not in ("check", "mark"):
        print('Usage: trello-progress check|mark "Project Name" [max_age_hours]', file=sys.stderr)
        return 2
    cmd, project = args[0], args[1]
    max_age_hours = float(args[2]) if len(args) > 2 else 6.0

    try:
        with open(STATE) as f:
            state = json.load(f)
    except (FileNotFoundError, json.JSONDecodeError):
        state = {"projects": {}}
    projects = state.setdefault("projects", {})

    now = datetime.now(timezone.utc)

    if cmd == "mark":
        projects[project] = now.isoformat()
        with open(STATE, "w") as f:
            json.dump(state, f, indent=2)
        print(f"MARKED: {project} @ {now.isoformat()}")
        return 0

    raw = projects.get(project, "")
    if not raw:
        print(f"POST: no prior comment for '{project}'")
        return 0
    try:
        last = datetime.fromisoformat(raw.replace("Z", "+00:00"))
        if last.tzinfo is None:
            last = last.replace(tzinfo=timezone.utc)
    except ValueError:
        print(f"POST: unreadable timestamp for '{project}' ({raw!r}); treating as stale")
        return 0

    age_min = (now - last).total_seconds() / 60
    if age_min < max_age_hours * 60:
        print(f"SKIP: '{project}' commented {int(age_min)} min ago (< {max_age_hours:g}h). Do not post another.")
        return 1
    print(f"POST: last comment for '{project}' was {int(age_min // 60)}h ago.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
