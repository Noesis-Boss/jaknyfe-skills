#!/usr/bin/env bash
set -u

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks not found — install it before pushing." >&2
  exit 1
fi
if [ "$(git rev-parse --is-bare-repository 2>/dev/null)" = "true" ]; then
  exit 0
fi
repo_root=$(git rev-parse --show-toplevel)
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    log_opts="$local_sha"
  else
    log_opts="$remote_sha..$local_sha"
  fi
  report=$(mktemp)
  if ! gitleaks git --log-opts="$log_opts" --no-banner --redact --report-format json --report-path "$report" "$repo_root" >/dev/null 2>&1; then
    echo "PUSH BLOCKED: gitleaks found secrets in $(basename "$repo_root") ($local_ref):" >&2
    python3 -c "
import json
for l in json.load(open('$report')):
    print(f\"  {l['File']} (rule={l['RuleID']}, commit={l['Commit'][:8]})\")" 2>/dev/null || head -20 "$report" >&2
    status=1
  fi
  rm -f "$report"
done
if [ "$status" -ne 0 ]; then
  echo "Fix: remove the secret, purge history if needed, or add confirmed false positives to .gitleaksignore" >&2
fi
exit "$status"
